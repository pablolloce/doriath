{
  "name": "BBVA × NFQ Brand Tokens",
  "version": "2025.02",
  "description": "Design tokens para presentaciones HTML BBVA producidas por NFQ",
  "color": {
    "primary": {
      "electric-blue": "#001391",
      "serene-blue":   "#85C8FF"
    },
    "grayscale": {
      "white":    "#FFFFFF",
      "sand":     "#F7F8F8",
      "gray-2":   "#E2E6EA",
      "gray-3":   "#CAD1D8",
      "gray-4":   "#ADB8C2",
      "gray-5":   "#46536D",
      "midnight": "#070E46",
      "deep":     "#000519"
    },
    "accent": {
      "canary":   "#FFE761",
      "lime":     "#88E783",
      "aqua":     "#8BE1E9",
      "ice":      "#8BE1E9",
      "purple":   "#9694FF",
      "mandarin": "#FFB56B"
    },
    "prohibited": {
      "pure-black": {
        "value": "#000000",
        "note": "No se usa negro puro. Usar #070E46 (Midnight) para texto oscuro."
      }
    }
  },
  "combinations": {
    "rule": "Texto sobre fondo acento → siempre #001391 (Electric Blue)",
    "A-sand":     { "bg": "#F7F8F8", "fg": "#001391", "accent": "#85C8FF", "bbva-logo": "BBVA_RGB.png",   "nfq-logo": "Nfq__Black.png" },
    "B-serene":   { "bg": "#85C8FF", "fg": "#001391", "accent": "#F7F8F8", "bbva-logo": "BBVA_RGB.png",   "nfq-logo": "Nfq__Black.png" },
    "C-electric": { "bg": "#001391", "fg": "#F7F8F8", "accent": "#85C8FF", "bbva-logo": "BBVA_WHITE.png", "nfq-logo": "Nfq__White.png" },
    "D-midnight": { "bg": "#070E46", "fg": "#F7F8F8", "accent": "#85C8FF", "bbva-logo": "BBVA_WHITE.png", "nfq-logo": "Nfq__White.png" }
  },
  "typography": {
    "display": {
      "family": "Source Serif 4",
      "fallback": ["Georgia", "Times New Roman", "serif"],
      "weight": 700,
      "italic": true,
      "use": "titulares"
    },
    "body": {
      "family": "Lato",
      "fallback": ["Helvetica Neue", "Arial", "sans-serif"],
      "weights": [300, 400, 700],
      "italic": true,
      "use": "todo lo que no sean titulares"
    },
    "google-fonts-url": "https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,700;1,8..60,700&family=Lato:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&display=swap",
    "scale": {
      "hero":    "clamp(72px, 7vw, 128px)",
      "h1":      "clamp(40px, 4vw, 72px)",
      "h2":      "clamp(28px, 2.5vw, 48px)",
      "h3":      "clamp(20px, 1.8vw, 32px)",
      "lead":    "clamp(18px, 1.3vw, 24px)",
      "body":    "clamp(14px, 1vw, 18px)",
      "caption": "clamp(11px, 0.75vw, 14px)",
      "label":   "clamp(10px, 0.7vw, 12px)"
    }
  },
  "layout": {
    "grid-unit": 8,
    "spacing": { "1": 8, "2": 16, "3": 24, "4": 32, "5": 40, "6": 48, "7": 56, "8": 64 },
    "radii":   { "sm": 8, "md": 16, "lg": 24, "xl": 32, "full": 9999 },
    "outer-margin": 64,
    "gap": 32,
    "aspect-ratio": "16/9",
    "viewport-px": [1920, 1080]
  },
  "assets": {
    "icons": {
      "path": "./docs/visual/icons/",
      "format": "svg",
      "count": 171,
      "default-color": "#001391"
    },
    "logos": {
      "bbva-color": "./docs/visual/logos/BBVA_RGB.png",
      "bbva-white": "./docs/visual/logos/BBVA_WHITE.png",
      "nfq-black":  "./docs/visual/logos/Nfq__Black.png",
      "nfq-white":  "./docs/visual/logos/Nfq__White.png",
      "nfq-isotype": "./docs/visual/logos/Isotipo__Nfq__Color.png"
    }
  },
  "rules": {
    "hard": [
      "No usar negro puro (#000000).",
      "Texto sobre acento siempre en #001391.",
      "Tipografía: Source Serif 4 (titulares) + Lato (resto).",
      "Logo BBVA en todas las slides interiores.",
      "Logo NFQ en portada y contraportada como mínimo.",
      "Logo NFQ nunca más alto que el logo BBVA.",
      "Iconos solo de ./docs/visual/icons/ (171 disponibles).",
      "Sobre fotografía no se usa opacity/velado para legibilidad — usar caja sólida superpuesta."
    ],
    "soft": [
      "Múltiplos de 8 px en espaciado, múltiplos de 4 px en radios.",
      "Titulares de 1-3 líneas.",
      "Pocos UI stickers por slide (1-3 es razonable).",
      "Acentos con moderación — no convertir cada slide en arcoíris."
    ]
  }
}
